# ─────────────────────────────────────────────────────────────────────
# Feathers – The 2nd Skin — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://feathers:feathers@localhost:5440/feathers"

# Random string, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
SESSION_HOURS=12

# Public address of the site (canonical URLs, sitemap, payment callbacks)
APP_URL="http://localhost:3600"

# ── Brand / WhatsApp ──────────────────────────────────────────────────
# WhatsApp number with country code, digits only (e.g. 919876543210)
WHATSAPP_NUMBER="919876543210"
WHATSAPP_BUSINESS_NAME="Feathers – The 2nd Skin"
STORE_PHONE="+91 98765 43210"
STORE_EMAIL="hello@feathers2ndskin.in"
STORE_ADDRESS="Kerala, India"
INSTAGRAM_URL="https://www.instagram.com/feathers_the_2ndskin_/"
FACEBOOK_URL=""

# ── Shipping (₹) ──────────────────────────────────────────────────────
SHIPPING_FLAT=79
FREE_SHIPPING_ABOVE=1499
ESTIMATED_DELIVERY="3–7 working days across India"

# ── Payment gateway ───────────────────────────────────────────────────
# razorpay (UPI, cards, net banking, wallets) or mock (development/testing only;
# refused when NODE_ENV=production unless ALLOW_MOCK_PAYMENTS=true).
PAYMENT_GATEWAY="mock"
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""
# Razorpay Dashboard → Webhooks → secret. Webhook URL: {APP_URL}/api/payments/webhook
PAYMENT_WEBHOOK_SECRET=""
# Minutes an unpaid online order holds its stock
PAYMENT_HOLD_MINUTES=30
# Hours an unconfirmed WhatsApp order holds its stock
WHATSAPP_HOLD_HOURS=24

# Protects /api/cron/maintenance (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ── File storage ──────────────────────────────────────────────────────
# Uploaded product photos and stitching images are kept here
STORAGE_DIR="./storage"

# ── Password reset email (optional) ───────────────────────────────────
# Without RESEND_API_KEY the reset link is written to the server log.
RESEND_API_KEY=""
MAIL_FROM="Feathers <no-reply@feathers2ndskin.in>"
