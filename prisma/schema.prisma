// NABA Boutique — “Feathers – The 2nd Skin”
// Online store + inventory / purchasing / sales back office.
//
// Stock rule: a variant's `stock` is never edited directly. Every change goes
// through src/server/stock.ts, which writes a StockMovement row with the
// previous and new stock, so the history always explains the current number.
// `reserved` holds units promised to unpaid online / WhatsApp orders; customers
// can buy only `stock - reserved`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Staff ─────────────────────────────

enum AdminRole {
  ADMIN
  CASHIER
}

model AdminUser {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  role             AdminRole      @default(CASHIER)
  isActive         Boolean        @default(true)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("admin_sessions")
}

// ──────────────────────────── Catalogue ────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("categories")
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  subcategory  String?
  shortDesc    String?
  description  String?
  fabric       String?
  careNotes    String?
  supplierId   String?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  isFeatured   Boolean          @default(false)
  isNewArrival Boolean          @default(false)
  isBestSeller Boolean          @default(false)
  status       ProductStatus    @default(ACTIVE)
  soldCount    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]

  @@index([categoryId, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

/// One sellable SKU: a size + colour of a product. Holds price and stock.
model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String          @unique
  size          String          @default("Free Size")
  color         String          @default("")
  price         Decimal         @db.Decimal(12, 2)
  mrp           Decimal         @db.Decimal(12, 2)
  costPrice     Decimal         @default(0) @db.Decimal(12, 2)
  stock         Int             @default(0)
  reserved      Int             @default(0)
  lowStockLevel Int             @default(3)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movements     StockMovement[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]

  @@index([productId])
  @@map("product_variants")
}

enum MovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  EXCEL_IMPORT
  ORDER_CANCELLED
}

model StockMovement {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  note          String?
  userName      String?
  createdAt     DateTime       @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

// ───────────────────────────── Buying ─────────────────────────────

model Supplier {
  id          String     @id @default(cuid())
  name        String
  companyName String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  gstin       String?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  purchases   Purchase[]
  products    Product[]

  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum SupplierPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Purchase {
  id                String                @id @default(cuid())
  number            String                @unique
  supplierId        String
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  supplierContact   String?
  invoiceNumber     String?
  purchaseDate      DateTime
  paymentStatus     SupplierPaymentStatus @default(UNPAID)
  status            PurchaseStatus        @default(DRAFT)
  subtotal          Decimal               @default(0) @db.Decimal(12, 2)
  discount          Decimal               @default(0) @db.Decimal(12, 2)
  additionalCharges Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal               @default(0) @db.Decimal(12, 2)
  notes             String?
  createdByName     String?
  receivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             PurchaseItem[]
  returns           PurchaseReturn[]

  @@index([purchaseDate])
  @@map("purchases")
}

/// A purchase line. `variantId` is null while a draft line describes a product
/// that does not exist yet; it is created when the purchase is received.
model PurchaseItem {
  id            String          @id @default(cuid())
  purchaseId    String
  purchase      Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName   String
  sku           String
  categoryId    String?
  categoryName  String?
  size          String          @default("Free Size")
  color         String          @default("")
  quantity      Int
  purchasePrice Decimal         @db.Decimal(12, 2)
  sellingPrice  Decimal         @db.Decimal(12, 2)
  mrp           Decimal?        @db.Decimal(12, 2)
  discount      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  returnedQty   Int             @default(0)

  @@index([purchaseId])
  @@map("purchase_items")
}

model PurchaseReturn {
  id            String               @id @default(cuid())
  number        String               @unique
  purchaseId    String
  purchase      Purchase             @relation(fields: [purchaseId], references: [id])
  reason        String?
  amount        Decimal              @db.Decimal(12, 2)
  createdByName String?
  createdAt     DateTime             @default(now())
  items         PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  return         PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItemId String
  quantity       Int
  amount         Decimal        @db.Decimal(12, 2)

  @@map("purchase_return_items")
}

// ───────────────────────────── Selling ─────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  whatsapp  String?
  email     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("customers")
}

enum OrderChannel {
  ONLINE
  WHATSAPP
  STORE
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  UPI
  CARD
  CASH
  BANK_TRANSFER
  OTHER
}

/// RESERVED: units held in variant.reserved. COMMITTED: stock reduced.
/// RELEASED: reservation given back without a sale.
enum StockState {
  RESERVED
  COMMITTED
  RELEASED
}

/// Orders are the "Sales" of the back office: online, WhatsApp and counter sales.
model Order {
  id             String         @id @default(cuid())
  number         String         @unique
  accessKey      String
  channel        OrderChannel
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  phone          String
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  deliveryNotes  String?
  mrpTotal       Decimal        @db.Decimal(12, 2)
  subtotal       Decimal        @db.Decimal(12, 2)
  extraDiscount  Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  tax            Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus  @default(UNPAID)
  status         OrderStatus    @default(PENDING)
  stockState     StockState     @default(RESERVED)
  reservedUntil  DateTime?
  cashierName    String?
  courier        String?
  trackingNumber String?
  adminNotes     String?
  needsAttention String?
  paidAt         DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          OrderItem[]
  payments       Payment[]
  returns        SalesReturn[]
  statusHistory  OrderStatusLog[]

  @@index([createdAt])
  @@index([status])
  @@index([phone])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  sku         String
  size        String
  color       String
  quantity    Int
  price       Decimal        @db.Decimal(12, 2)
  mrp         Decimal        @db.Decimal(12, 2)
  costPrice   Decimal        @db.Decimal(12, 2)
  total       Decimal        @db.Decimal(12, 2)
  returnedQty Int            @default(0)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  userName  String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_logs")
}

enum GatewayPaymentStatus {
  CREATED
  SUCCESS
  FAILED
}

/// Only safe references returned by the gateway are stored — never card data.
model Payment {
  id                String               @id @default(cuid())
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerOrderId   String               @unique
  providerPaymentId String?
  method            String?
  amount            Decimal              @db.Decimal(12, 2)
  status            GatewayPaymentStatus @default(CREATED)
  errorReason       String?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([orderId])
  @@map("payments")
}

model SalesReturn {
  id            String            @id @default(cuid())
  number        String            @unique
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  reason        String?
  refundMethod  PaymentMethod
  refundAmount  Decimal           @db.Decimal(12, 2)
  createdByName String?
  createdAt     DateTime          @default(now())
  items         SalesReturnItem[]

  @@index([createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id          String      @id @default(cuid())
  returnId    String
  return      SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  quantity    Int
  amount      Decimal     @db.Decimal(12, 2)
  restocked   Boolean     @default(true)

  @@map("sales_return_items")
}

// ─────────────────────────── Stitching ───────────────────────────

enum StitchingStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StitchingRequest {
  id                String           @id @default(cuid())
  number            String           @unique
  name              String
  phone             String
  whatsapp          String?
  material          String?
  size              String?
  bust              String?
  waist             String?
  hip               String?
  shoulder          String?
  sleeveLength      String?
  dressLength       String?
  otherMeasurements String?
  stitchingStyle    String?
  neckDesign        String?
  sleeveDesign      String?
  instructions      String?
  status            StitchingStatus  @default(NEW)
  adminNotes        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  images            StitchingImage[]

  @@index([status, createdAt])
  @@map("stitching_requests")
}

enum StitchingImageKind {
  REFERENCE
  MATERIAL
  INSPIRATION
}

model StitchingImage {
  id        String             @id @default(cuid())
  requestId String
  request   StitchingRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      StitchingImageKind
  path      String
  createdAt DateTime           @default(now())

  @@map("stitching_images")
}

// ─────────────────────────── Marketing ───────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  location   String?
  rating     Int      @default(5)
  text       String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("reviews")
}

enum CouponType {
  PERCENT
  FLAT
}

/// Reserved for a later coupons feature; not used by checkout yet.
model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Decimal    @db.Decimal(12, 2)
  minOrder   Decimal    @default(0) @db.Decimal(12, 2)
  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?
  usedCount  Int        @default(0)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@map("coupons")
}

model Sequence {
  key   String @id
  value Int

  @@map("sequences")
}
