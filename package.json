{
  "name": "feathers-the-2nd-skin",
  "version": "1.0.0",
  "private": true,
  "description": "NABA Boutique (Feathers – The 2nd Skin): ladies fashion & customized stitching store with inventory, purchasing and sales back office",
  "scripts": {
    "dev": "next dev -p 3600",
    "build": "prisma generate && next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "dev:db": "node scripts/dev-db.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:e2e": "tsx tests/e2e/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
